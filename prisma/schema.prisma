generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  features    String[]
  price       Float
  category    String
  colors      Json
  images      String[]
  inStock     Boolean  @default(true)
  isPromo     Boolean  @default(false)
  promoPrice  Float?
  isNew       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Settings {
  id            String  @id @default("singleton")
  whatsapp      String
  mapsUrl       String
  instagramUrl  String
  facebookUrl   String
  tiktokUrl     String
  shippingText  String  @default("Envios a nivel nacional")
  businessHours String  @default("")
  showPrices    Boolean  @default(true)
  qualityReportUrl String @default("")
  updatedAt     DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
