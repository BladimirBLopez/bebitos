generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  features    String[]
  price       Float
  category    String
  colors      Json
  images      String[]
  stock       Int      @default(0)  // ← NUEVO CAMPO
  inStock     Boolean  @default(false) // ← SE CALCULA AUTOMÁTICAMENTE
  isPromo     Boolean  @default(false)
  promoPrice  Float?
  isNew       Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id            String  @id @default("singleton")
  whatsapp      String
  mapsUrl       String
  instagramUrl  String
  facebookUrl   String
  tiktokUrl     String
  shippingText  String  @default("Envios a nivel nacional")
  businessHours String  @default("")
  showPrices    Boolean @default(true)
  qualityReportUrl String @default("")
  updatedAt     DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  whatsapp  String
  babyAge   String   @default("")
  source    String   @default("regalo")
  createdAt DateTime @default(now())
}

model GiftResource {
  id        String   @id @default(cuid())
  label     String
  image     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id         String       @id @default(cuid())
  customer   String
  email      String?
  phone      String
  total      Float
  status     OrderStatus  @default(pendiente)
  items      OrderItem[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productId   String
  productName String
  quantity    Int
  price       Float
  createdAt   DateTime @default(now())
}

enum OrderStatus {
  pendiente
  confirmado
  enviado
  entregado
  cancelado
}
